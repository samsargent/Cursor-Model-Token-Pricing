{
  "manifest_version": 3,
  "name": "Cursor Model Pricing",
  "version": "1.3",
  "description": "Displays live Input/Output token pricing in the Cursor model selector.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://cursor.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://cursor.com/*",
        "https://*.cursor.com/*"
      ],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ]
}